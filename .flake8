[flake8]
max-line-length = 88
extend-ignore = E203, W503, E501
exclude = 
    .git,
    __pycache__,
    .venv,
    venv,
    migrations/,
    .pytest_cache,
    build,
    dist
per-file-ignores =
    __init__.py:F401
    conftest.py:F401,F811
max-complexity = 10
import-order-style = google
application-import-names = backend
docstring-convention = google