# Production Environment Configuration
# Local Business Intelligence Bot

# Application Settings
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
WORKERS=4

# Database Configuration
POSTGRES_DB=businessbot
POSTGRES_USER=businessbot
POSTGRES_PASSWORD=your-secure-password-here
DATABASE_URL=postgresql://businessbot:your-secure-password-here@postgres:5432/businessbot

# Redis Configuration
REDIS_PASSWORD=your-redis-password-here
REDIS_URL=redis://:your-redis-password-here@redis:6379/0

# Security Configuration
JWT_SECRET_KEY=your-jwt-secret-key-here-make-it-long-and-random
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=7

# AI Service API Keys
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# External API Keys
GOOGLE_PLACES_API_KEY=your-google-places-api-key-here

# Email Configuration (for notifications)
SMTP_HOST=smtp.yourdomain.com
SMTP_PORT=587
SMTP_USERNAME=noreply@yourdomain.com
SMTP_PASSWORD=your-smtp-password-here
SMTP_USE_TLS=true

# SMS Configuration (optional)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Application URLs
FRONTEND_URL=https://businessbot.yourdomain.com
BACKEND_URL=https://businessbot.yourdomain.com/api
ALLOWED_ORIGINS=https://businessbot.yourdomain.com,https://www.businessbot.yourdomain.com

# Monitoring Configuration
GRAFANA_PASSWORD=your-grafana-password-here
PROMETHEUS_RETENTION=30d

# Backup Configuration
BACKUP_ENCRYPTION_KEY=your-backup-encryption-key-here
BACKUP_S3_BUCKET=businessbot-backups
BACKUP_S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# Performance Settings
MAX_WORKERS=8
WORKER_TIMEOUT=300
KEEP_ALIVE=2
MAX_REQUESTS=1000
MAX_REQUESTS_JITTER=50

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=100

# File Upload Limits
MAX_UPLOAD_SIZE=10485760  # 10MB
ALLOWED_FILE_TYPES=csv,json,txt

# Cache Settings
CACHE_TTL=3600  # 1 hour
CACHE_MAX_SIZE=1000

# AI Service Limits
OPENAI_MAX_TOKENS=4000
ANTHROPIC_MAX_TOKENS=4000
AI_REQUEST_TIMEOUT=60
AI_MAX_RETRIES=3

# Cost Management
MONTHLY_COST_LIMIT=500.00
COST_WARNING_THRESHOLD=0.8  # 80%

# GDPR Compliance
DATA_RETENTION_DAYS=365
ANONYMIZATION_ENABLED=true
CONSENT_REQUIRED=true

# Security Headers
SECURITY_HEADERS_ENABLED=true
HSTS_MAX_AGE=31536000
CSP_ENABLED=true

# Logging Configuration
LOG_FORMAT=json
LOG_FILE=/app/logs/businessbot.log
LOG_MAX_SIZE=100MB
LOG_BACKUP_COUNT=5

# Health Check Configuration
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=10
HEALTH_CHECK_RETRIES=3

# Database Pool Settings
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# Redis Pool Settings
REDIS_POOL_SIZE=20
REDIS_POOL_TIMEOUT=10

# Kubernetes Settings (if using K8s)
K8S_NAMESPACE=businessbot-prod
K8S_SERVICE_ACCOUNT=businessbot-sa

# SSL/TLS Configuration
SSL_CERT_PATH=/etc/ssl/certs/businessbot.crt
SSL_KEY_PATH=/etc/ssl/private/businessbot.key
SSL_VERIFY=true

# Feature Flags
FEATURE_ADVANCED_ANALYTICS=true
FEATURE_MULTI_LANGUAGE=true
FEATURE_REAL_TIME_ALERTS=true
FEATURE_COST_TRACKING=true
FEATURE_GDPR_COMPLIANCE=true
FEATURE_BACKUP_ENCRYPTION=true

# Third-party Integrations
SENTRY_DSN=your-sentry-dsn-here
DATADOG_API_KEY=your-datadog-api-key-here
NEW_RELIC_LICENSE_KEY=your-newrelic-license-key-here